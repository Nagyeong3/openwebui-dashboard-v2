# 프로젝트 루트의 .env로 복사해 사용합니다. 기존 .env를 예제로 덮어쓰지 마세요.
# UTF-8 또는 UTF-8 BOM 지원. SET/export 없이 KEY=값 형식으로 입력합니다.
# 주석은 별도 줄에 작성합니다. 키·암호는 외부에 공유하지 마세요.

# =================================================================
# 1. OpenWebUI 연결 | 사용자 명부와 질문 데이터를 읽습니다.
# =================================================================
# OpenWebUI 서버 주소. 운영 서버에서 접근 가능한 주소로 입력합니다.
OPENWEBUI_URL=http://127.0.0.1:8080
# OpenWebUI 관리자 계정의 API 키. LiteLLM 키와 다릅니다.
OPENWEBUI_API_TOKEN=

# =================================================================
# 2. 파일 위치 | 상대 경로는 프로젝트 루트 .env 위치 기준입니다.
# =================================================================
# 사용자·질문 분석 DB 경로. 기존 파일을 옮기면 수집 이력이 유지됩니다.
DASHBOARD_CACHE_PATH=data/dashboard-v2.sqlite3
# 조직 매핑 CSV 경로. 준비되지 않았다면 비워 둡니다.
ORG_USER_CSV_PATH=
# 빌드된 index.html과 assets가 있는 폴더. 반입본은 frontend_v2/dist입니다.
DASHBOARD_FRONTEND_DIR=frontend_v2/dist

# =================================================================
# 3. OpenWebUI 수집 | 요청 크기·재시도·변경분 중복 조회를 조절합니다.
# =================================================================
# API 한 페이지 조회 건수. 1~100.
OPENWEBUI_PAGE_SIZE=100
# API 요청 제한 시간(초). 1~120.
OPENWEBUI_TIMEOUT_SECONDS=30
# 요청 실패 시 재시도 횟수. 0~5.
OPENWEBUI_MAX_RETRIES=2
# 사용자별 최대 조회 페이지 수. 무한 조회 방지용입니다.
OPENWEBUI_MAX_PAGES_PER_USER=10000
# 마지막 성공 시점보다 며칠 앞에서 중복 조회할지 지정합니다. 전체 조회 기간 제한이 아닙니다.
SYNC_OVERLAP_DAYS=7

# =================================================================
# 4. 대시보드 접속 | 선택적 암호 및 별도 출처 접근 설정입니다.
# =================================================================
# 선택 사항: 대시보드 접속 암호. OpenWebUI/LiteLLM 키와 별개입니다.
DASHBOARD_API_TOKEN=
# 화면과 API가 다른 출처일 때 허용할 주소를 쉼표로 구분합니다. 같은 출처면 비워 둡니다.
DASHBOARD_CORS_ORIGINS=

# =================================================================
# 5. LiteLLM 토큰 수집 | 분류 모델 호출과 독립적으로 사용 로그를 읽습니다.
# =================================================================
# LiteLLM 토큰·비용 DB 경로. 다른 DB와 별도 파일을 사용합니다.
TOKEN_CACHE_DB_PATH=data/token_usage_v2.sqlite3
# LiteLLM 서버 기본 주소. /v1을 붙이지 않습니다.
LITELLM_BASE_URL=
# 토큰 로그 조회 권한을 가진 키. 질문 분류용 추론 키와 역할이 다릅니다.
LITELLM_API_KEY=
# 수집 대상 키 별칭. 비워 두면 키 별칭으로 제한하지 않습니다.
LITELLM_REQUIRED_API_KEY_ALIAS=
# LiteLLM 사용 로그 API 경로.
LITELLM_SPEND_LOGS_PATH=/spend/logs/v2
# 한 페이지 로그 수. 최대 100.
LITELLM_LOG_LIMIT=100
# 마지막 성공 시점에서 추가로 겹쳐 읽을 시간. 월 1회 실행해도 한 달 전체+이 여유분을 조회합니다. 7일은 168.
LITELLM_SYNC_LOOKBACK_HOURS=24
# 최초/전체 토큰 수집 시작일. 실행 전 YYYY-MM-DD 형식으로 입력합니다.
LITELLM_SYNC_START_DATE=
# 시간대 정보가 없는 로그와 조회 날짜에 적용할 시간대. 실제 로그 기준에 맞춥니다.
LITELLM_LOG_TIMEZONE=UTC
# 조회 구간별 최대 페이지 수. 무한 조회 방지용입니다.
LITELLM_MAX_PAGES_PER_WINDOW=10000
# 선택 사항: 비용이 누락된 로그에 사용할 모델 가격 CSV. 실제 기록 비용(0 포함)이 우선입니다.
MODEL_PRICES_CSV_PATH=

# =================================================================
# 6. 질문 카테고리 분류 | CSV 정의와 LiteLLM 모델을 사용합니다.
# =================================================================
# 질문 분류 결과 DB. 다른 DB와 별도 파일을 사용합니다.
CATEGORY_CACHE_DB_PATH=data/category_v2.sqlite3
# 카테고리 정의 CSV 경로(category,description,keywords,examples,active).
CATEGORY_DEFINITIONS_CSV_PATH=data/question_categories.csv
# 분류용 LiteLLM 주소. 비우면 LITELLM_BASE_URL 사용. /v1 포함 여부 모두 허용합니다.
CATEGORY_LITELLM_BASE_URL=
# 질문 분류 모델 호출에 사용할 추론 권한 키.
CATEGORY_LITELLM_API_KEY=
# LiteLLM에 등록된 분류 모델 이름.
CATEGORY_LLM_MODEL=
# 내부 처리 구간 크기. 전체 미처리 분류는 버튼 한 번으로 모든 구간을 이어 처리합니다.
CATEGORY_LLM_MAX_QUESTIONS=200
# 모델 요청 한 번에 묶을 질문 수. 1~20.
CATEGORY_BATCH_SIZE=5
# 질문별 모델 전달 최대 글자 수. 100~16000.
CATEGORY_MAX_QUESTION_CHARS=6000
# 모델 자체 평가 점수 기준(0~1). 통계적 정확도 확률은 아닙니다.
CATEGORY_MIN_CONFIDENCE=0.65
# response_format 지원 모델은 true. 미지원 모델만 false로 설정합니다.
CATEGORY_JSON_MODE=true
# 모델/CSV 변경 없이 재분류 버전을 바꾸려면 값을 증가시킵니다.
CATEGORY_CLASSIFIER_REVISION=1

# =================================================================
# 7. 운영 작업 | 업데이트 진행 상태와 실행 이력을 보관합니다.
# =================================================================
# 운영 실행 이력 DB. 비우면 분석 DB 옆 operations_v2.sqlite3 사용. 다른 DB와 분리합니다.
OPERATIONS_CACHE_DB_PATH=
# 서버가 켜져 있을 때 매주 월요일 08:30(한국 시간)에 데이터→토큰→분류 일반 업데이트.
# 브라우저를 열 필요가 없습니다. false이면 자동 실행 해제. 수동 업데이트는 그대로 사용합니다.
# 서버 중단/다른 작업으로 놓친 예약은 24시간 이내 한 번 보충합니다.
DASHBOARD_AUTO_UPDATE_ENABLED=true
